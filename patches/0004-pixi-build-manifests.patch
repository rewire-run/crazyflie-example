diff --git a/crazyflie/pixi.toml b/crazyflie/pixi.toml
new file mode 100644
index 0000000..b563a52
--- /dev/null
+++ b/crazyflie/pixi.toml
@@ -0,0 +1,24 @@
+[package]
+name = "crazyflie"
+version = "1.0.5"
+
+[package.build]
+backend = { name = "pixi-build-ros", version = "==0.4.1" }
+
+[package.build.config]
+distro = "jazzy"
+extra-package-mappings = [{
+  crazyflie_interfaces = { conda = [] },
+  crazyflie_description = { conda = [] },
+  motion_capture_tracking_interfaces = { conda = [] },
+  "libusb-1.0-dev" = { conda = ["libusb"] },
+}]
+
+[package.host-dependencies]
+crazyflie_interfaces = { path = "../crazyflie_interfaces" }
+motion_capture_tracking_interfaces = { path = "../../motion_capture_tracking/motion_capture_tracking_interfaces" }
+
+[package.run-dependencies]
+crazyflie_interfaces = { path = "../crazyflie_interfaces" }
+crazyflie_description = { path = "../crazyflie_description" }
+motion_capture_tracking_interfaces = { path = "../../motion_capture_tracking/motion_capture_tracking_interfaces" }
