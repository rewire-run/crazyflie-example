-           0.     ,   0.     ,   1.     ]
+  data: [181.87464,   0.     , 162.0,
+           0.     , 182.58129, 122.0,
+           0.     ,   0.     ,   1.  ]
 distortion_model: plumb_bob
 distortion_coefficients:
   rows: 1
   cols: 5
-  data: [-0.070366, -0.006434, -0.002691, -0.001983, 0.000000]
